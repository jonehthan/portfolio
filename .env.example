# Pooled Neon Postgres connection string (see the setup wizard / README).
# postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Spotify app credentials (developer.spotify.com/dashboard) + the refresh
# token from the one-time authorization, see the credentials setup wizard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# GitHub personal access token (read:user scope) + your username.
GITHUB_TOKEN=
GITHUB_USERNAME=

# Random secret protecting /api/dashboard/refresh. Vercel sends this
# automatically as a Bearer header for its own Cron Jobs once set on the
# project; for local testing, generate any random string yourself.
CRON_SECRET=

# Discogs personal access token (discogs.com/settings/developers) + your
# username. Powers the Record Collection section.
DISCOGS_TOKEN=
DISCOGS_USERNAME=
